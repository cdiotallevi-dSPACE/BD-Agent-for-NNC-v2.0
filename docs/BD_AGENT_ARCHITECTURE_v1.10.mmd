  classDef good fill:#E5F6EC,stroke:#27864B,color:#123B24,stroke-width:1.8px;
  classDef bad fill:#FDECEC,stroke:#B84343,color:#5A1D1D,stroke-width:1.7px;
  classDef artifact fill:#E3F5F4,stroke:#23837E,color:#123E3B,stroke-width:1.5px;
  classDef llm fill:#E8F7EE,stroke:#287D49,color:#123B24,stroke-width:1.7px;
  classDef principle fill:#FFFFFF,stroke:#111827,color:#111827,stroke-width:2px,stroke-dasharray:5 3;

  class DISCOVER,PARSE,CHUNK,INSTALL,MODELS,VERIFYINDEX,EVIDENCE,NEEDS,CANDIDATES,QUERY,RECORD,SCORE,WRITE,T1,T2,T3,T4,T5,T6 ingest;
  class EMBED,STORE,OPENINDEX,QUERYEMBED,RETRIEVE vector;
