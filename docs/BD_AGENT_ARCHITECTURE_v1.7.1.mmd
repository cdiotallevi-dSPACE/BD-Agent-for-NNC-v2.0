  classDef company fill:#EAF4FF,stroke:#1F6FB2,color:#12324A,stroke-width:1.8px;
  classDef need fill:#FFF4D6,stroke:#B7791F,color:#5F370E,stroke-width:1.8px;
  classDef dspace fill:#EEE8FF,stroke:#7152B3,color:#332155,stroke-width:1.8px;
  classDef llm fill:#E5F6EC,stroke:#27864B,color:#123B24,stroke-width:1.8px;
  classDef artifact fill:#E3F5F4,stroke:#23837E,color:#123E3B,stroke-width:1.4px;
  classDef control fill:#FFF8CC,stroke:#A67C00,color:#4F3B00,stroke-width:1.4px;
  classDef fallback fill:#FDECEC,stroke:#B84343,color:#5A1D1D,stroke-width:1.5px;
  classDef principle fill:#FFFFFF,stroke:#111827,color:#111827,stroke-width:2px,stroke-dasharray:5 3;

  class PREFLIGHT,SELECT,QUEUE,RUN,SEARCH,RETRIEVE,CACHE,EVIDENCE,NEED_DERIVE,CAP_REQ,BGE_QUERY,DSPACE_RETRIEVE,APPLICABILITY,HARD,RATE,ATOMIC,PENDING,AUDIT,CURATE,VALIDATE_LLM,RENDER,NEXT python;
  class COMPANY_TAX,COMPANY_ENTITIES,COMPANY_JSON company;
  class NEED_TAX,NEEDS need;
  class DSPACE_PDFS,INGEST,CHROMA,PORTFOLIO_YAML,ALIASES,PORTFOLIO_RESULT dspace;
  class MAP_RULES,MAP_JSON,FINAL,PDF,MD,MANIFEST artifact;
  class PROMPT,SUMMARY_LLM,NARRATIVE llm;
  class XLSX,WRITABLE control;
  class FALLBACK fallback;
  class RELATION,SCOPE_RULE principle;
